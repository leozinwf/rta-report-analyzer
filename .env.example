# Recursos de IA (a integração ainda usa providers em modo stub)
VITE_AI_ENABLED=false
VITE_AI_PROVIDER=disabled
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_OLLAMA_BASE_URL=http://localhost:11434

# Proteção temporária de acesso à aplicação
# Use uma senha forte e exclusiva. O segredo de sessão deve ter pelo menos 32 caracteres.
APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=
APP_SESSION_TTL_HOURS=8

# Jira
# Variáveis exclusivas do backend/serverless. Não adicione o prefixo VITE_.
JIRA_BASE_URL=https://dootax.atlassian.net
JIRA_EMAIL=seu-email-da-conta-atlassian
JIRA_API_TOKEN=seu-token
JIRA_JQL=project = DM AND statusCategory != Done ORDER BY updated DESC
JIRA_MAX_RESULTS=500
# Evita repetir consultas ao Jira quando mais de uma pessoa sincroniza ao mesmo tempo.
JIRA_CACHE_TTL_SECONDS=300

# Usado pela versão mais recente da consulta por sprint (o histórico usa 3 como padrão).
JIRA_BOARD_ID=3
